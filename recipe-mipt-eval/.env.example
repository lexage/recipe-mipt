# Настройки стенда для скриптов испытаний pk3 (кластер alibaba, узел ali117197).
# Скрипты создают .env из этого файла сами; в штатном сценарии испытаний
# правок не требуется.

# Образ, в котором исполняется весь питон (на узле питон 3.6).
IMG_ASLLM=10.0.117.197:5000/asllm:1.10.3-pytorch2.10.0-ubuntu24.04-sail2.1.0-cuda13.0-sglang0.5.12-vllm0.20.1-py312

# Веса моделей. Решатель и генератор правил — одна модель; её имя в API равно
# пути к весам (решатель грузит токенайзер по этому имени).
MODELS_ROOT=/bmcp_lvm_fs/cusa/models
LLM_MODEL_DIR=/bmcp_lvm_fs/cusa/models/Qwen3.6-35B-A3B
EMBED_MODEL_DIR=/home/trofimov/models/Qwen3-Embedding-4B
EMBED_API_NAME=Qwen/Qwen3-Embedding-4B

# Очередь slurm для сервисов моделей (длинная очередь лаборатории).
MODELS_PARTITION=prims-long
# Сколько секунд ждать готовности моделей (первый старт — до часа из-за JIT).
MODELS_READY_TIMEOUT=7200

# venv поверх образа (создаёт init-filter-gen.sh); должен лежать в $HOME.
VENV=$HOME/work/venv-recipe

# Хаб для однократной загрузки модели BM25 (разреженные векторы qdrant) и
# кеш fastembed. Зеркало, которое подставляет образ, этой модели не содержит.
HF_ENDPOINT=https://huggingface.co
FASTEMBED_CACHE_PATH=$HOME/.cache/fastembed

# Параллельные воркеры прогона DS-1000.
WORKERS=4
